  agents: {
    entries: {
      byeolsaem: { tools: { exec: { security: "full", ask: "off" } } },
      chaeksaem: { tools: { exec: { security: "full", ask: "off" } } },
      geulsaem:  { tools: { exec: { security: "full", ask: "off" } } },
    },
