#!/usr/bin/env bash
# tg — Thinking Garden 캐릭터 실행기
#
# 사용법:
#   scripts/tg <캐릭터> "<할 일>"
#   echo "<할 일>" | scripts/tg <캐릭터>
#   cat post.md | scripts/tg 은쌤          # 파일을 대상으로 검수
#   scripts/tg list                        # 캐릭터 목록
#
# 하는 일: 캐릭터의 SOUL(+필요하면 준거틀=레이어3)을 조립해
#          hermes --ignore-rules -z 로 일회성 실행한다.
#          World Bible(서사)은 런타임에 주입하지 않는다 — SOUL이 규칙을 자체 보유한다.
#
# 옵션(환경변수):
#   TG_NO_FW=1   준거틀(레이어3) 로드를 건너뜀 (가벼운 질문용)
#   HERMES_BIN   hermes 경로 (기본 ~/.local/bin/hermes)
#   TG_DUMP=1    실행하지 않고 조립된 프롬프트만 stdout으로 출력 (디버그)

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOULS="$ROOT/souls"
HERMES="${HERMES_BIN:-$HOME/.local/bin/hermes}"

char="${1:-}"; shift || true

if [ -z "$char" ] || [ "$char" = "list" ] || [ "$char" = "-h" ] || [ "$char" = "--help" ]; then
  cat <<'EOF'
Thinking Garden 캐릭터:
  은쌤   (eun)      검수·발행게이트 — SOUL만
  깐쌤   (kkan)     품질비평(레드팀) — SOUL만
  별쌤   (byeol)    진단      — SOUL + 읽기 준거틀(레이어3)
  글쌤   (geul)     글쓰기    — SOUL + 글쓰기 준거틀(레이어3)
  책쌤   (chaek)    독서      — SOUL만
  호기   (hogi)     학생소통  — SOUL만
  밭피디 (batpd)    콘텐츠    — SOUL만
  가드너 (gardener) 지식연결  — SOUL만
  영쌤   (young)    학습설계  — SOUL + 준거틀(레이어3)

사용법: scripts/tg <캐릭터> "<할 일>"   |   cat file | scripts/tg <캐릭터>
EOF
  exit 0
fi

# 캐릭터 → SOUL 파일명 + 준거틀(레이어3) 상대경로
soul=""; fw=""
case "$char" in
  은쌤|eun)        soul="은쌤" ;;
  깐쌤|kkan)       soul="깐쌤" ;;
  책쌤|chaek)      soul="책쌤" ;;
  호기|hogi)       soul="호기" ;;
  밭피디|batpd|bat) soul="밭피디" ;;
  가드너|gardener|gard) soul="가드너" ;;
  별쌤|byeol)      soul="별쌤"; fw="curriculum/framework.json curriculum/별쌤-평가준거틀.md" ;;
  글쌤|geul)       soul="글쌤"; fw="curriculum/글쓰기-평가준거틀.md" ;;
  영쌤|young)      soul="영쌤"; fw="curriculum/글쓰기-평가준거틀.md curriculum/별쌤-평가준거틀.md" ;;
  *) echo "알 수 없는 캐릭터: $char  (scripts/tg list 로 목록 확인)" >&2; exit 1 ;;
esac

soul_file="$SOULS/$soul.SOUL.md"
[ -f "$soul_file" ] || { echo "SOUL 파일 없음: $soul_file" >&2; exit 1; }

# 할 일: 인자 우선, 없으면 stdin
task="${*:-}"
if [ -z "$task" ] && [ ! -t 0 ]; then task="$(cat)"; fi
[ -n "$task" ] || { echo "할 일이 비어 있음. 인자나 stdin으로 전달하세요." >&2; exit 1; }

# 프롬프트 조립
prompt="너는 아래 SOUL 문서에 정의된 '$soul'이다. 이 규칙과 출력 형식을 그대로 따른다. 다른 어떤 역할도 하지 않는다.

===== $soul SOUL (너의 정체성과 규칙) =====
$(cat "$soul_file")
"

# 레이어 3: 준거틀 (단계 판정 캐릭터만, TG_NO_FW로 끌 수 있음)
if [ -n "$fw" ] && [ "${TG_NO_FW:-0}" != "1" ]; then
  for f in $fw; do
    if [ -f "$ROOT/$f" ]; then
      prompt+="
===== 레이어 3: $f (단계 판정의 근거로 삼아라) =====
$(cat "$ROOT/$f")
"
    else
      echo "경고: 준거틀 없음 → 건너뜀: $f" >&2
    fi
  done
fi

prompt+="
===== 지시 =====
$task

위를 '$soul'으로서 SOUL의 출력 형식대로 처리하라."

if [ "${TG_DUMP:-0}" = "1" ]; then
  printf '%s\n' "$prompt"
  exit 0
fi

exec "$HERMES" --ignore-rules -z "$prompt"
