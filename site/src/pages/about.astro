---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

import buildingImg from '../assets/characters/building_exterior.png';
import groupPhoto from '../assets/characters/group_with_philo.png';
import byeolsaem from '../assets/characters/byeolsaem_clay.png';
import chaeksaem from '../assets/characters/chaeksaem_clay.png';
import geulsaem from '../assets/characters/geulsaem_clay.png';
import eunsaem from '../assets/characters/eunsaem_clay.png';
import hogi from '../assets/characters/hogi_clay.png';
import philo from '../assets/characters/philo_clay.png';

const members = [
  { name: '별쌤', role: '따뜻한 여우 선생님, 진단의 설계자', desc: '문해력과 글쓰기의 7단계 평가틀을 설계하는 평가 전문가입니다.', img: byeolsaem },
  { name: '책쌤', role: '안경 쓴 부엉이, 지문의 큐레이터', desc: '학생의 글쓰기에 마중물이 될 지문을 골라 학습 흐름에 연결합니다.', img: chaeksaem },
  { name: '글쌤', role: '베레모 쓴 고양이, 글쓰기의 코치', desc: '학생의 글에 반응하고, 다음 한 줄을 끌어내는 질문을 돌려줍니다.', img: geulsaem },
  { name: '은쌤', role: '사람입니다! 교육과정의 파수꾼', desc: '모든 산출물의 교육과정 부합 여부를 최종 검수하는 리더입니다.', img: eunsaem },
  { name: '호기', role: '골든 리트리버 강아지, 학생의 친구', desc: '좋은 질문을 던지고, 진단 결과를 학생 눈높이에서 전달하는 또래 친구입니다.', img: hogi },
  { name: '필로', role: '안경 쓴 회청색 토끼, 코디네이터', desc: '팀의 전체 흐름을 조율하고, 블로그로 이야기를 전합니다.', img: philo },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead
      title={`소개 — ${SITE_TITLE}`}
      description="생각하는 글밭을 소개합니다."
    />
    <style>
      main {
        width: 720px;
      }
      .about h1 {
        margin-bottom: 0.5em;
      }
      .about p {
        line-height: 1.8;
        color: rgb(var(--gray-dark));
      }
      .about h2 {
        margin-top: 2em;
        margin-bottom: 0.6em;
        font-size: 1.3em;
        color: rgb(var(--gray-dark));
        word-break: keep-all;
      }
      .manifesto-slogan {
        font-size: 1.2em;
        line-height: 1.5;
        font-weight: 600;
        color: rgb(var(--gray-dark));
        border-left: 4px solid var(--accent);
        padding: 0.9em 1.4em;
        margin: 1.2em 0 1.8em;
        background: var(--accent-light);
        font-style: normal;
        word-break: keep-all;
      }
      .team {
        margin-top: 2em;
      }
      .group-photo {
        margin: 1.5em 0;
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.1);
      }
      .member {
        display: flex;
        gap: 1.5em;
        align-items: flex-start;
        padding: 1.5em 0;
        border-bottom: 1px solid rgb(var(--gray-light));
      }
      .member-img {
        flex-shrink: 0;
        border-radius: 12px;
      }
      .member-info h3 {
        margin-bottom: 0.2em;
      }
      .member-info .role {
        font-size: 0.9em;
        color: rgb(var(--gray));
      }
      .member-info p {
        margin-top: 0.3em;
      }
      @media (max-width: 720px) {
        .member {
          flex-direction: column;
          align-items: center;
          text-align: center;
        }
      }
      .support {
        margin-top: 3em;
        padding-top: 2em;
        border-top: 1px solid rgb(var(--gray-light));
      }
      .support-intro {
        font-style: italic;
        color: rgb(var(--gray));
        margin-bottom: 1.5em;
      }
      .support-box {
        border-radius: 12px;
        padding: 1.5em;
        margin-bottom: 1em;
      }
      .support-box.blue { border: 2px solid #4A6FA5; background: #F0F5FF; }
      .support-box.orange { border: 2px solid #F4A261; background: #FFFAF4; }
      .support-box.gray { border: 1px solid #e0e0e0; background: #FAFAFA; }
      .box-header {
        display: flex;
        align-items: center;
        gap: 0.6em;
        margin-bottom: 0.8em;
      }
      .pill {
        font-size: 0.75em;
        font-weight: 700;
        padding: 0.2em 0.7em;
        border-radius: 20px;
        color: white;
      }
      .pill.blue { background: #4A6FA5; }
      .pill.orange { background: #F4A261; }
      .tag {
        font-size: 0.8em;
        padding: 0.15em 0.6em;
        border-radius: 8px;
      }
      .tag.blue { background: #E8F0FE; color: #4A6FA5; }
      .tag.orange { background: #FEF3E2; color: #8B5E34; }
      .stbl { width: 100%; font-size: 0.9em; margin: 0; }
      .stbl td { padding: 0.4em 0.8em; }
      .stbl td:first-child { font-weight: 600; width: 90px; }
      .blue .stbl td { border-color: #c8d8f0; }
      .orange .stbl td { border-color: #f4d0a8; }
      .blue .stbl td:first-child { color: #2D4A6F; }
      .orange .stbl td:first-child { color: #8B5E34; }
      .support-hint { margin-top: 0.8em; font-size: 0.85em; color: #5a7aa5; }
      .support-closing {
        margin-top: 2em;
        padding: 1.5em;
        background: var(--accent-light);
        border-radius: 12px;
        border-left: 4px solid var(--accent);
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="about">
        <Image src={buildingImg} alt="생각하는 글밭 건물 외관" width={720} class="group-photo" />
        <h1>생각하는 글밭을 소개합니다</h1>

        <blockquote class="manifesto-slogan">
          읽고 쓰며 생각을 기르는 곳 — Where Thoughts Grow
        </blockquote>

        <h2>우리가 만드는 것</h2>
        <p>
          생각하는 글밭은 초등 3학년부터 중학 3학년까지의 학생을 대상으로,
          <strong>글쓰기</strong>를 통해 사고력과 문해력을 길러내는 온라인 서비스입니다.
          자기 수준을 진단하고, 그 자리에서 시작하는 7단계 글쓰기 학습을 따라가다 보면,
          AI 시대에 가장 필요한 능력, <strong>좋은 질문을 던지는 힘</strong>이 자랍니다.
        </p>

        <h2>왜 글쓰기인가</h2>
        <p>
          세계경제포럼은 2030년 가장 필요한 능력으로 분석적 사고와 호기심을 꼽았습니다.
          OECD는 비판적 사고를 "질문하고 평가하는 능력"으로 정의했고, 한국의 2022 개정 교육과정도
          정답을 찾는 학습에서 탐구하고 질문하는 학습으로 축을 옮겼습니다.
        </p>
        <p>
          같은 방향을 가리키는 또 다른 신호가 있습니다. MIT 미디어랩이 ChatGPT 사용자 54명을 4개월간 추적했더니,
          뇌 연결성이 절반 가까이 줄었습니다. 첫 세션 직후 사용자 열에 여덟은, 자신이 방금 쓴 글에서
          한 문장도 옮겨오지 못했습니다. 답은 점점 흔해지는데, 그 답을 자기 것으로 만드는 능력은 점점 약해지는 시대.
          그 한가운데에 질문이 있습니다.
        </p>
        <p>
          지난 50년의 작문 교육 연구가 가리키는 결론은 한 줄로 요약됩니다.
          좋은 질문은 글을 써본 만큼 자랍니다. 글을 쓰는 동안 사람은 자기 생각의 빈 곳을 마주합니다.
          막히는 모든 지점이 "왜? 근거는? 반례는?" 같은 질문을 저절로 만들어냅니다.
          글쓰기는 사고가 끝난 뒤에 일어나는 일이 아니라, 사고가 일어나는 자리입니다.
        </p>

        <h2>학생이 만나는 학습</h2>
        <p>
          온라인에서 혼자 배우는 학습은 쉽게 외로워집니다. 그래서 우리는 학습을
          "쓰기 훈련"이 아니라 "생각 탐험"으로 설계합니다.
        </p>
        <p>
          설명을 길게 늘어놓는 대신 짧은 질문을 던집니다. 답이 길어야 좋은 글이라고 말하지 않습니다.
          한 문장도 충분한 시작입니다. 학생이 한 줄을 쓰면 캐릭터가 반응합니다.
          반응이 또 다른 질문이 되고, 그 질문이 다음 한 줄을 부릅니다.
          짧은 루프가 촘촘하게 반복되는 동안, 학생은 자기 생각이 움직이는 것을 느낍니다.
        </p>
        <p>
          캐릭터들은 단순한 마스코트가 아닙니다. 학생이 화면 너머에서 혼자 쓰지 않도록 만들어주는
          정서적 인터페이스입니다. 그리고 캐릭터들은 학생의 글을 기억합니다.
          자기 이야기가 누군가의 관심 안에 있다는 감각, 그것이 학생을 다시 돌아오게 합니다.
        </p>

        <h2>AI를 쓰는 방식</h2>
        <p>
          AI가 글을 대신 써주는 시대라고들 합니다. 우리는 그 흐름을 따르지 않습니다.
          사고를 외주하면, 사고하는 능력 자체가 자라지 않기 때문입니다.
          학생이 처음부터 글을 AI에 맡기면, 잃는 것은 글 한 편으로 끝나지 않습니다.
          사고할 기회 전부를 함께 잃습니다.
        </p>
        <p>
          생각하는 글밭에서 AI는 학생의 글을 대신 쓰지 않습니다.
          학생이 쓴 글에 좋은 질문을 돌려주는 코치로 일합니다.
          그리고 우리는 한 걸음 더 갑니다. AI가 흉내 낼 수 없는 문장을 쓰는 법,
          진짜 내 경험과 부끄러움과 이상한 기억으로만 쓸 수 있는 문장을 만드는 법,
          AI의 답에 반박해보는 법까지 가르칩니다.
          그 과정에서 학생은 자기가 어떤 면에서 AI와 다른 존재인지 발견하게 됩니다.
        </p>

        <h2>우리가 만들고 싶은 공간</h2>
        <p>
          전 세계 어디서든, 원하는 시간에 접속해 한 줄 한 줄 자기 생각을 쌓아갈 수 있는 공간을 목표로 합니다.
          AI 시대에 학생들이 답을 얻을 곳은 어디에나 있지만,
          자기 질문, 자기 생각, 자기 언어, 자기 관점을 발견하는 경험은 점점 더 희귀한 일이 됩니다.
          생각하는 글밭은 그 희귀한 경험이 일어나는 자리이고 싶습니다.
          글쓰기 교육 플랫폼을 넘어, 생각이 살아나는 공간으로요.
        </p>

        <Image src={groupPhoto} alt="생각하는 글밭 팀" width={720} class="group-photo" />

        <div class="team">
          <h2>팀 소개</h2>
          {members.map((m) => (
            <div class="member">
              <Image src={m.img} alt={m.name} width={120} class="member-img" />
              <div class="member-info">
                <h3>{m.name}</h3>
                <p class="role">{m.role}</p>
                <p>{m.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="support" id="support">
          <h2>생각하는 글밭을 함께 만들어주세요</h2>
          <p>
            생각하는 글밭은 벤처 투자도, 대기업 후원도 받지 않습니다.
            오직 <strong>"좋은 질문이 아이의 미래를 바꾼다"</strong>고 믿는 사람들의 힘으로 만들어지고 있습니다.
            특히 AI API 운영 비용이 커지면서 여러분의 도움이 절실합니다.
          </p>
          <p>
            1,000원도 괜찮습니다. 한 달에 커피 한 잔 값도 충분합니다.
            여러분의 후원 하나가 이 공간이 계속 살아 숨쉬게 합니다.
          </p>

          <div class="support-box blue">
            <div class="box-header">
              <span class="pill blue">방법 1</span>
              <strong>CMS 자동이체</strong>
              <span class="tag blue">연말정산 가능</span>
            </div>
            <p style="margin: 0 0 0.8em; font-size: 0.95em;">CCC 선교후원회를 통해 신청하시면 연말정산 세액공제가 가능합니다.</p>
            <table class="stbl">
              <tr><td>전화</td><td>02-397-6300</td></tr>
              <tr><td>후원번호</td><td><strong>3811</strong></td></tr>
              <tr><td>이름</td><td>이재은 (CCC 협동간사)</td></tr>
            </table>
            <p class="support-hint">전화로 <em>"후원번호 3811, 이재은 간사 후원 신청"</em>이라고 말씀해 주세요.</p>
          </div>

          <div class="support-box orange">
            <div class="box-header">
              <span class="pill orange">방법 2</span>
              <strong>계좌이체</strong>
              <span class="tag orange">연말정산 불가</span>
            </div>
            <p style="margin: 0 0 0.8em; font-size: 0.95em;">간편하게 바로 이체하실 수 있습니다.</p>
            <table class="stbl">
              <tr><td>은행</td><td>카카오뱅크</td></tr>
              <tr><td>예금주</td><td>이재은</td></tr>
              <tr><td>계좌번호</td><td><strong>3333-18-2696209</strong></td></tr>
            </table>
          </div>

          <div class="support-box gray">
            <div class="box-header">
              <strong>후원 문의</strong>
            </div>
            <p style="margin: 0; font-size: 0.95em;">
              담당: 이재은 &nbsp;·&nbsp;
              <a href="mailto:bluesk21@hanmail.net">bluesk21@hanmail.net</a>
            </p>
          </div>

          <div class="support-closing">
            <strong>질문은 답보다 오래 삽니다.</strong><br />
            생각하는 글밭도 그렇게, 오래 살아남고 싶습니다.
          </div>
        </div>

      </div>
    </main>
    <Footer />
  </body>
</html>
