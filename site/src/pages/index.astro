---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import CharacterFamily from '../components/CharacterFamily.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { APP_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import signboard from '../assets/characters/signboard_thinkingfield.png';

const posts = (await getCollection('blog')).filter(
  (post) => post.data.status === 'published',
);

const originSeries = posts
  .filter((p) => p.data.series === '생각하는 글밭은 이렇게 시작되었습니다')
  .sort((a, b) => (a.data.seriesNumber ?? 0) - (b.data.seriesNumber ?? 0));

const devlogSeries = posts
  .filter((p) => p.data.series === '생각하는 글밭 개발일지')
  .sort((a, b) => (a.data.seriesNumber ?? 0) - (b.data.seriesNumber ?? 0));

// 가장 최근 개발일지 = 지금의 모습 (오리엔테이션 CTA에서 사용)
const latestDevlog = devlogSeries[devlogSeries.length - 1];

const cardnewsSeries = posts
  .filter((p) => p.data.series === '생각하는 글밭 카드뉴스')
  .sort((a, b) => (a.data.seriesNumber ?? 0) - (b.data.seriesNumber ?? 0));
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      .hero {
        text-align: center;
        padding: 2em 0 1em;
      }
      .signboard {
        border-radius: 12px;
        margin-bottom: 1.2em;
      }
      .hero h1 {
        font-size: 2em;
        margin-bottom: 0.3em;
        word-break: keep-all;
      }
      .hero p {
        color: rgb(var(--gray));
        font-size: 1.1em;
        max-width: 500px;
        margin: 0 auto;
        line-height: 1.7;
      }
      .section {
        margin-top: 3em;
      }
      .section-title {
        font-size: 1.3em;
        margin-bottom: 1em;
        padding-bottom: 0.5em;
        border-bottom: 2px solid var(--accent);
        display: inline-block;
      }
      .series-list {
        list-style: none;
        padding: 0;
        margin: 0;
        counter-reset: series;
      }
      .series-item {
        counter-increment: series;
        padding: 0.8em 0;
        border-bottom: 1px solid rgb(var(--gray-light));
      }
      .series-item a {
        text-decoration: none;
        color: rgb(var(--gray-dark));
        display: flex;
        align-items: baseline;
        gap: 0.8em;
      }
      .series-item a:hover {
        color: var(--accent);
      }
      .series-num {
        font-size: 0.85em;
        color: var(--accent);
        font-weight: 700;
        min-width: 2em;
      }
      .series-title {
        font-weight: 500;
      }
      .post-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .post-item {
        padding: 1em 0;
        border-bottom: 1px solid rgb(var(--gray-light));
      }
      .post-item a {
        text-decoration: none;
        color: inherit;
      }
      .post-item a:hover .post-title {
        color: var(--accent);
      }
      .post-title {
        font-size: 1.1em;
        font-weight: 600;
        margin: 0.2em 0;
        transition: color 0.2s;
        word-break: keep-all;
      }
      .post-meta {
        display: flex;
        align-items: center;
        gap: 0.5em;
        font-size: 0.8em;
        color: rgb(var(--gray));
      }
      .post-meta .dot { opacity: 0.4; }
      .view-all {
        display: inline-block;
        margin-top: 1.5em;
        color: var(--accent);
        font-weight: 500;
      }
      /* 오리엔테이션(처음 온 사람용) */
      .intro {
        max-width: 620px;
        margin: 0.5em auto 0;
      }
      .intro-lead {
        text-align: center;
        font-size: 1.05em;
        line-height: 1.8;
        color: rgb(var(--gray-dark));
        margin: 0;
      }
      .status-card {
        margin-top: 1.6em;
        border: 1px solid var(--accent);
        background: var(--accent-light);
        border-radius: 14px;
        padding: 1.1em 1.4em;
      }
      .status-eyebrow {
        font-size: 0.8em;
        font-weight: 700;
        letter-spacing: 0.04em;
        color: var(--accent);
        margin: 0 0 0.5em;
      }
      .status-list {
        margin: 0;
        padding-left: 1.2em;
        line-height: 1.75;
        color: rgb(var(--gray-dark));
      }
      .status-list li { margin-bottom: 0.25em; }
      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6em;
        justify-content: center;
        margin-top: 1.5em;
      }
      .cta {
        display: inline-block;
        padding: 0.65em 1.25em;
        border-radius: 10px;
        border: 1px solid var(--accent);
        color: var(--accent);
        font-weight: 600;
        font-size: 0.95em;
        text-decoration: none;
        transition: opacity 0.2s;
      }
      .cta.primary { background: var(--accent); color: #fff; }
      .cta:hover { opacity: 0.82; }
      .section-desc {
        color: rgb(var(--gray));
        font-size: 0.92em;
        margin: -0.3em 0 1.1em;
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="hero">
        <Image src={signboard} alt="생각하는 글밭 간판" width={360} class="signboard" />
        <h1>생각하는 글밭</h1>
        <p>읽고 쓰며 생각을 기르는 곳<br />Where Thoughts Grow</p>
      </div>

      <section class="intro">
        <p class="intro-lead">
          생각하는 글밭은 초등 3학년부터 중학 3학년까지, <strong>글쓰기로 생각하는 힘</strong>을
          기르는 온라인 학습 서비스예요. 자기 수준을 진단받고, 그 자리에서 시작하는
          7단계 글쓰기 수업을 AI 코치의 첨삭과 함께 따라갑니다.
        </p>

        <div class="status-card">
          <p class="status-eyebrow">지금, 생각하는 글밭은</p>
          <ul class="status-list">
            <li>읽기·쓰기 진단부터 7단계 글쓰기 수업, AI 첨삭까지 <strong>실제로 작동해요.</strong></li>
            <li>한국어가 처음인 영어권 학생을 위한 <strong>한글 초급 트랙</strong>도 열렸어요.</li>
            <li>다음 주, 마닐라 한국 아카데미 여름캠프에서 <strong>첫 교실 수업</strong>을 해요.</li>
          </ul>
        </div>

        <div class="cta-row">
          <a class="cta primary" href={APP_URL} target="_blank" rel="noopener">진단·수업 시작하기</a>
          <a class="cta" href="/about">생각하는 글밭이란?</a>
          {latestDevlog && <a class="cta" href={`/blog/${latestDevlog.id}/`}>지금의 모습 보기</a>}
        </div>
      </section>

      <div class="section">
        <h2 class="section-title">글밭 식구들</h2>
        <CharacterFamily />
      </div>

      {originSeries.length > 0 && (
        <section class="section">
          <h2 class="section-title">생각하는 글밭은 이렇게 시작되었습니다</h2>
          <p class="section-desc">왜 이 일을 시작했는지, 어떤 마음으로 만드는지 담은 이야기예요.</p>
          <ol class="series-list">
            {originSeries.map((post) => (
              <li class="series-item">
                <a href={`/blog/${post.id}/`}>
                  <span class="series-num">{post.data.seriesNumber}편</span>
                  <span class="series-title">{post.data.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}

      {devlogSeries.length > 0 && (
        <section class="section">
          <h2 class="section-title">생각하는 글밭 개발일지</h2>
          <p class="section-desc">만들어온 과정을 순서대로 기록했어요. 가장 최근 글이 지금의 모습이에요.</p>
          <ol class="series-list">
            {devlogSeries.map((post) => (
              <li class="series-item">
                <a href={`/blog/${post.id}/`}>
                  <span class="series-num">{post.data.seriesNumber}편</span>
                  <span class="series-title">{post.data.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}

      {cardnewsSeries.length > 0 && (
        <section class="section">
          <h2 class="section-title">생각하는 글밭 카드뉴스</h2>
          <p class="section-desc">짧게 읽는 카드 모음이에요.</p>
          <ol class="series-list">
            {cardnewsSeries.map((post) => (
              <li class="series-item">
                <a href={`/blog/${post.id}/`}>
                  <span class="series-num">{post.data.seriesNumber}편</span>
                  <span class="series-title">{post.data.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}

      <a href="/blog" class="view-all">모든 글 보기 &rarr;</a>
    </main>
    <Footer />
  </body>
</html>
