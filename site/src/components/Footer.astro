---
const today = new Date();
---

<footer>
  <p>&copy; {today.getFullYear()} 생각하는 글밭. All rights reserved.</p>
  <p class="sub">
    읽고 쓰며 생각을 기르는 곳 — Where Thoughts Grow
  </p>
</footer>
<style>
  footer {
    padding: 2em 1em 4em 1em;
    background: linear-gradient(var(--gray-gradient)) no-repeat;
    color: rgb(var(--gray));
    text-align: center;
    font-size: 0.9em;
  }
  footer p {
    margin: 0.3em 0;
  }
  .sub {
    font-size: 0.85em;
    opacity: 0.7;
  }
</style>
