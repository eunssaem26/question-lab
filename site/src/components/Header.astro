---
import { APP_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

interface Props {
  lang?: 'ko' | 'en';
}

const { lang = 'ko' } = Astro.props;
---

<header>
  <nav>
    <h2><a href={lang === 'en' ? '/en' : '/'}>{SITE_TITLE}</a></h2>
    <div class="internal-links">
      {
        lang === 'ko' ? (
          <>
            <HeaderLink href="/">홈</HeaderLink>
            <HeaderLink href="/game/">게임</HeaderLink>
            <HeaderLink href="/blog">글 목록</HeaderLink>
            <HeaderLink href="/about">소개</HeaderLink>
            <HeaderLink href="/about#support">후원</HeaderLink>
          </>
        ) : (
          <>
            <HeaderLink href="/en">Home</HeaderLink>
            <HeaderLink href="/">Blog (한국어)</HeaderLink>
          </>
        )
      }
    </div>
    <div class="actions">
      {
        lang === 'ko' ? (
          <a class="lang-toggle" href="/en" aria-label="English version">
            EN
          </a>
        ) : (
          <a class="lang-toggle" href="/" aria-label="한국어 버전">
            한국어
          </a>
        )
      }
      <a class="login-btn" href={`${APP_URL}/login`}>Log in</a>
    </div>
  </nav>
</header>
<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: white;
    box-shadow: 0 1px 4px rgba(var(--black), 8%);
  }
  h2 {
    margin: 0;
    font-size: 1em;
  }
  h2 a,
  h2 a.active {
    text-decoration: none;
    color: var(--accent-dark);
    font-weight: 700;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 720px;
    margin: 0 auto;
  }
  nav a {
    padding: 1em 0.5em;
    color: rgb(var(--gray-dark));
    border-bottom: 3px solid transparent;
    text-decoration: none;
    font-size: 0.95em;
  }
  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--accent);
    color: var(--accent-dark);
  }
  nav a:hover {
    color: var(--accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }
  .lang-toggle {
    padding: 0.35em 0.6em;
    font-size: 0.85em;
    font-weight: 600;
    color: rgb(var(--gray-dark));
    border: 1px solid rgb(var(--gray-light));
    border-radius: 6px;
  }
  .lang-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .login-btn {
    padding: 0.45em 1em;
    font-size: 0.9em;
    font-weight: 700;
    color: white;
    background: var(--accent);
    border-radius: 8px;
  }
  .login-btn:hover {
    color: white;
    opacity: 0.85;
  }
  @media (max-width: 720px) {
    nav {
      flex-direction: column;
      gap: 0;
      padding-bottom: 0.8em;
    }
    .internal-links {
      display: flex;
      gap: 0;
    }
  }
</style>
